# Vercel's npm install-scripts guard blocks postinstall scripts of
# @parcel/watcher / @swc/core / unrs-resolver (all are transitive deps of
# tailwindcss v4 and eslint-config-next). These packages ship prebuilt
# platform binaries (@swc/core-linux-x64-gnu, tailwindcss-oxide, etc.) and
# their install scripts only link/validate them, so ignoring them is safe.
ignore-scripts=true
